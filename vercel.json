{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/@yka_yka",
      "destination": "/wallplan/@yka_yka/",
      "statusCode": 308
    },
    {
      "source": "/for-kirill-specially-ru",
      "destination": "/ru/",
      "statusCode": 308
    },
    {
      "source": "/for-kirill-specially-ru/",
      "destination": "/ru/",
      "statusCode": 308
    }
  ],
  "rewrites": [
    {
      "source": "/@yka_yka/",
      "destination": "/@yka_yka/index.html"
    },
    {
      "source": "/for-kirill-specially-ru",
      "destination": "/for-kirill-specially-ru/index.html"
    },
    {
      "source": "/zh",
      "destination": "/zh/index.html"
    },
    {
      "source": "/zh/",
      "destination": "/zh/index.html"
    },
    {
      "source": "/ru",
      "destination": "/ru/index.html"
    },
    {
      "source": "/ru/",
      "destination": "/ru/index.html"
    },
    {
      "source": "/he",
      "destination": "/he/index.html"
    },
    {
      "source": "/he/",
      "destination": "/he/index.html"
    },
    {
      "source": "/ar",
      "destination": "/ar/index.html"
    },
    {
      "source": "/ar/",
      "destination": "/ar/index.html"
    },
    {
      "source": "/((?!for-kirill-specially-ru|@yka_yka|zh|ru|he|ar).*)",
      "destination": "/index.html"
    }
  ]
}